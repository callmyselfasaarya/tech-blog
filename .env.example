# ==========================================
# Master Environment Variables Documentation
# ==========================================

# ------------------------------------------
# 1. FRONTEND / CLIENT (PUBLIC - VITE_*)
# Anything starting with VITE_ will be bundled into the browser JavaScript.
# DO NOT put private backend secrets here!
# ------------------------------------------
VITE_SANITY_PROJECT_ID=pbxpf8xj
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-01-01
VITE_API_URL=https://api.techniccal.com

# ------------------------------------------
# 2. BACKEND / SERVER (PRIVATE SECRETS ONLY)
# Kept strictly server-side on Node.js / Express.
# Never expose to the browser!
# ------------------------------------------
PORT=5000
NODE_ENV=production
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/techniccal-blog?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your-production-jwt-access-secret-key-change-this-2026
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-key-change-this-2026

SANITY_PROJECT_ID=pbxpf8xj
SANITY_DATASET=production
SANITY_API_TOKEN=your-private-sanity-write-token

FRONTEND_URL=https://techniccal.com

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@techniccal.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@techniccal.com
