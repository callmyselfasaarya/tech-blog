# Server Environment Secrets (Private backend configuration ONLY)
# Never expose these secrets to the frontend client!

PORT=5000
NODE_ENV=production

# Database Connection URL (MongoDB / Atlas)
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/techniccal-blog?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your-production-jwt-access-secret-key-change-this-2026
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-key-change-this-2026

# Sanity Headless CMS Backend Integration
SANITY_PROJECT_ID=pbxpf8xj
SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-write-api-token-secret

# Frontend Application Origin
FRONTEND_URL=https://techniccal.com

# SMTP Email Dispatch Server (Optional for transactional emails & verification)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@techniccal.com
SMTP_PASSWORD=your-smtp-password-secret
SMTP_FROM=no-reply@techniccal.com
